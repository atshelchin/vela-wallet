<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      INTERNET (spec 019-onboarding-live-wiring).

      Spec 014's slice was genuinely offline and this file said so. It stopped
      being true the moment onboarding was wired to the core: `registry_publish`,
      `registry_query_by_public_key`, `registry_query_unit`, `lookup_legacy_name`
      and `probe_index_health` all reach p256-index-v2.getvela.app, and the
      passkey ceremony's provider syncs.

      Device-found 2026-08-25: without it, minting a passkey succeeded and then
      Confirm failed with "Permission denied (missing INTERNET permission?)" —
      the worst possible order, because the person already has a credential in
      their provider by then.

      ACCESS_NETWORK_STATE is deliberately NOT requested. The shell's one job in
      classifying a failure is `network`: did the request reach the server. That
      is answered by what the call did, not by what the radio claims — a
      connectivity check can say "connected" behind a captive portal and "no
      network" on a working VPN, and either answer would put the wrong sheet in
      front of somebody.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".VelaWalletApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VelaWallet">
        <!--
            The same HID-keyboard problem, one layer out.

            Credential Manager runs its request through `HiddenActivity`, which
            androidx declares in ITS manifest — with
            `orientation|screenSize|screenLayout|keyboardHidden`. That set
            anticipated a rotation, not a KEYBOARD APPEARING: a USB security key
            enumerates as one, `keyboard` flips NOKEYS→QWERTY mid-ceremony, and
            the activity holding the pending request is destroyed under it. The
            authenticator finishes the registration — GMS logs "Success in
            handleRegistration with credential" — and the answer lands on a
            controller that is already gone, so the app is told
            `TYPE_INTERRUPTED` ("The UI was interrupted") or, when the selector
            unwinds first, `TYPE_USER_CANCELED` by somebody who cancelled
            nothing (Galaxy S22, Android 15, device-found 2026-08-26).

            So the library's own declaration is extended rather than replaced:
            its four, plus the three a HID device actually changes. These
            activities are transparent proxies awaiting a result — surviving a
            configuration change is exactly what they need to do.
        -->
        <activity
            android:name="androidx.credentials.playservices.HiddenActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|touchscreen"
            tools:node="merge"
            tools:replace="android:configChanges" />
        <activity
            android:name="androidx.credentials.playservices.IdentityCredentialApiHiddenActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|touchscreen"
            tools:node="merge"
            tools:replace="android:configChanges" />

        <!--
            A USB security key enumerates as a HID KEYBOARD. Plugging one in
            changes `keyboard`/`keyboardHidden`/`navigation`, and an activity that
            does not declare those is destroyed and relaunched — in the middle of
            the passkey ceremony the person plugged the key in FOR. The key mints
            the credential; the app that asked for it is already gone, and the
            create flow silently restarts on the welcome screen (device-found
            2026-08-26: "finishDrawing of relaunch … MainActivity" in logcat on
            every attempt, and ten register operations with zero answers).

            Compose reads configuration through the composition rather than
            through a restart, so handling these costs nothing and is what makes
            a hardware key usable at all. `locale` and `layoutDirection` are
            deliberately absent: the i18n runtime is built at startup, and a
            language change should still rebuild it.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="keyboard|keyboardHidden|navigation|touchscreen|screenSize|smallestScreenSize|screenLayout|density|fontScale|uiMode"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.VelaWallet"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
