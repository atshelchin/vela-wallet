<?xml version="1.0" encoding="utf-8"?>
<!--
    Themed-icon layer. The launcher discards our colours entirely and tints the
    shape from the user's wallpaper palette, so only coverage and alpha survive
    - every shape is one flat white, and the two sails are deliberately NOT
    distinguished, because at themed-icon sizes a tonal split reads as noise.

    Previously <monochrome> pointed at ic_launcher_foreground, which is a
    full-colour drawable; that hands the tinter three different luminances and
    produces a muddy silhouette. Same group transform as the foreground.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.08"
        android:scaleY="1.08"
        android:translateX="17.28"
        android:translateY="17.28">
        <path
            android:fillColor="#ffffff"
            android:pathData="M33,12C25,21,20,32,17,42L33,42L33,12Z" />
        <path
            android:fillColor="#ffffff"
            android:pathData="M36,19C45,25,50,34,52,42L36,42L36,19Z" />
        <path
            android:fillColor="#ffffff"
            android:pathData="M13,46L55,46C52,52,47,55,40,55L28,55C21,55,16,52,13,46Z" />
    </group>
</vector>
