<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The associated-domains entitlement is what lets the macOS platform
  authenticator ("This device" — Touch ID / iCloud Keychain passkeys) serve
  this app for getvela.app. It only takes effect under a REAL team signature
  (VELA_SIGN_IDENTITY in build-macos-app.sh); the domain's
  apple-app-site-association already lists F9W689P9NE.app.getvela.VelaWallet,
  which is this bundle's id under that team. Ad-hoc builds carry the file but
  the system ignores it — the platform rows then fail with the system's own
  "not associated" sentence, which is the honest dev-build behaviour.
-->
<plist version="1.0">
<dict>
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>webcredentials:getvela.app</string>
    </array>
</dict>
</plist>
