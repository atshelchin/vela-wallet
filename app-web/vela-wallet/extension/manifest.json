{
	"manifest_version": 3,
	"name": "Vela Wallet",
	"version": "0.1.0",
	"description": "The passkey wallet, in your browser. One address across 12+ networks, no seed phrase.",
	"key": "",
	"minimum_chrome_version": "116",
	"action": {
		"default_title": "Vela Wallet"
	},
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"permissions": ["storage", "tabs"],
	"host_permissions": ["https://getvela.app/*"],
	"content_security_policy": {
		"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
	}
}
