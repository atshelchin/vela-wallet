{
	"manifest_version": 3,
	"name": "Vela Wallet",
	"version": "0.1.0",
	"description": "The passkey wallet, in your browser. One address across 12+ networks, no seed phrase.",
	"key": "",
	"minimum_chrome_version": "116",
	"action": {
		"default_title": "Vela Wallet"
	},
	"background": {
		"service_worker": "background.js"
	},
	"permissions": ["storage", "tabs"],
	"host_permissions": ["https://getvela.app/*", "*://*/*"],
	"content_security_policy": {
		"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
	},
	"content_scripts": [
		{
			"matches": ["*://*/*"],
			"js": ["inpage.js"],
			"run_at": "document_start",
			"world": "MAIN",
			"all_frames": false
		},
		{
			"matches": ["*://*/*"],
			"js": ["content.js"],
			"run_at": "document_start",
			"all_frames": false
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["inpage.js"],
			"matches": ["*://*/*"]
		}
	]
}
