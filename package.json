    "@types/jest": "^30.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.0",
    "esbuild": "0.25.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.1",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.4.1",
    "js-sha3": "^0.9.3",
    "ts-jest": "^29.4.9",
    "typescript": "~5.9.2",
    "ws": "^8.18.3"
  },
  "private": true
}
