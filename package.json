    "expo-clipboard": "^55.0.13",
    "expo-constants": "~55.0.15",
    "expo-dev-client": "~55.0.36",
    "expo-device": "~55.0.15",
    "expo-document-picker": "~55.0.14",
    "expo-file-system": "~55.0.20",
    "expo-font": "~55.0.6",
    "expo-glass-effect": "~55.0.10",
    "expo-haptics": "^55.0.14",
    "expo-image": "~55.0.9",
    "expo-image-picker": "~55.0.20",
    "expo-linking": "~55.0.14",
    "expo-localization": "~55.0.15",
    "expo-media-library": "~55.0.17",
    "expo-router": "~55.0.13",
    "expo-sharing": "~55.0.18",
    "expo-splash-screen": "~55.0.19",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "expo-system-ui": "~55.0.16",
    "expo-updates": "~55.0.25",
    "expo-web-browser": "~55.0.14",
    "i18next": "^26.3.1",
    "identicons-esm": "1.0.1",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "lucide-react-native": "^1.11.0",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
