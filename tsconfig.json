{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  // These are separate projects with their own TypeScript environments. The
  // site needs SvelteKit's generated `$types`, while the Safe extension needs
  // WXT's generated config, Chrome types, package-local dependencies and `@`
  // alias. `app-web/vela-wallet` is the same case a second time: its own
  // SvelteKit project, its own pnpm dependency set and its own tsconfig, so the
  // root typecheck can only ever report its imports as unresolvable.
  // CI typechecks each project with its own package command.
  // Listing an explicit `exclude` overrides the default, so node_modules must
  // be re-listed.
  //
  // The sibling scaffolds need no entry: app-ios is Swift, app-android Kotlin
  // and app-desktop Rust — none of them contains TypeScript for tsc to find.
  "exclude": [
    "node_modules",
    "app-web/getvela.app",
    "app-web/vela-wallet",
    "packages/safe-recovery-extension",
    "dist",
    "test-results"
  ]
}
